    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^10.1.1",
    "@google/generative-ai": "^0.15.0",
    "@prisma/client": "^6.2.1",
    "@sentry/node": "^10.69.0",
    "@sentry/profiling-node": "^10.69.0",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.10.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "openai": "^4.55.0",
    "posthog-node": "^5.47.11",
    "razorpay": "^2.9.8",
    "resend": "^6.18.1",
    "socket.io": "^4.8.1",
    "tiktoken": "^1.0.13"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "prisma": "^6.2.1",
    "tsup": "^8.5.1",
