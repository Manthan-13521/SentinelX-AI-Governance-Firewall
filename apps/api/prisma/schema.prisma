generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String
  role           String   @default("EMPLOYEE")
  department     String   @default("Engineering")
  password       String
  avatarUrl      String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization?                @relation(fields: [organizationId], references: [id])
  audits       AuditLog[]
  sessions     Session[]
  riskEvents   RiskEvent[]
  apiKeys      ApiKey[]
  usageLedgers UsageLedger[]
  modelPerms   EmployeeModelPermission[]
  provPerms    EmployeeProviderPermission[]
  aiRequests   AIRequest[]
}

model AuditLog {
  id                String   @id @default(cuid())
  userId            String?
  promptHash        String
  prompt            String
  rewrittenPrompt   String?
  violations        Json
  riskScore         Float    @default(0)
  threatLevel       String   @default("LOW")
  policiesTriggered Json
  secrets           Json
  decision          String   @default("ALLOW")
  llmProvider       String?
  llmModel          String?
  latencyMs         Int?
  timestamp         DateTime @default(now())
  ipAddress         String?
  sessionId         String?
  agentTrace        Json?
  user              User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
  @@index([riskScore])
}

model Policy {
  id          String   @id @default(cuid())
  name        String
  description String
  regulation  String
  category    String
  rules       Json
  severity    String   @default("HIGH")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DetectionRule {
  id                 String   @id @default(cuid())
  name               String
  category           String
  pattern            String
  severity           String   @default("HIGH")
  enabled            Boolean  @default(true)
  description        String
  falsePositiveCount Int      @default(0)
  truePositiveCount  Int      @default(0)
  createdAt          DateTime @default(now())
}

model RiskEvent {
  id        String   @id @default(cuid())
  userId    String?
  score     Float
  level     String
  details   Json
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([timestamp])
}

model Alert {
  id           String   @id @default(cuid())
  title        String
  description  String
  severity     String   @default("MEDIUM")
  source       String
  acknowledged Boolean  @default(false)
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Session {
  id        String    @id @default(cuid())
  userId    String?
  active    Boolean   @default(true)
  ipAddress String?
  userAgent String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  user      User?     @relation(fields: [userId], references: [id])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users        User[]
  apiKeys      ApiKey[]
  usageLedgers UsageLedger[]
  budgets      Budget[]
  quotas       Quota[]
  rateLimits   RateLimitPolicy[]
  modelPerms   EmployeeModelPermission[]
  provPerms    EmployeeProviderPermission[]
  aiRequests   AIRequest[]
}

model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  organizationId String?
  name           String
  keyPrefix      String
  keyHash        String
  scopes         Json?
  status         String    @default("ACTIVE") // ACTIVE, REVOKED, EXPIRED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  revokedAt      DateTime?

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  usageLedgers UsageLedger[]
  aiRequests   AIRequest[]

  @@index([keyHash])
}

model UsageLedger {
  id             String   @id @default(cuid())
  requestId      String?  @unique
  userId         String
  organizationId String?
  apiKeyId       String?
  model          String
  provider       String
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens    Int      @default(0)
  estimatedCost  Float    @default(0)
  actualCost     Float?
  latencyMs      Int?
  status         String
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id])
  aiRequest    AIRequest?    @relation(fields: [requestId], references: [id])

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
}

model Budget {
  id              String   @id @default(cuid())
  organizationId  String?
  userId          String?
  dailyBudget     Float?
  monthlyBudget   Float?
  currency        String   @default("USD")
  enforcementMode String   @default("HARD") // HARD or SOFT
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model Quota {
  id                  String   @id @default(cuid())
  organizationId      String?
  userId              String?
  dailyTokenLimit     Int?
  monthlyTokenLimit   Int?
  maxTokensPerRequest Int?
  dailyRequestLimit   Int?
  monthlyRequestLimit Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model RateLimitPolicy {
  id                 String   @id @default(cuid())
  organizationId     String?
  userId             String?
  requestsPerMinute  Int?
  requestsPerHour    Int?
  concurrentRequests Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([userId])
}

model EmployeeModelPermission {
  id             String   @id @default(cuid())
  userId         String?
  organizationId String?
  allowedModels  Json     @default("[]")
  deniedModels   Json     @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
}

model EmployeeProviderPermission {
  id               String   @id @default(cuid())
  userId           String?
  organizationId   String?
  allowedProviders Json     @default("[]")
  deniedProviders  Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
}

model AIRequest {
  id             String   @id @default(cuid())
  userId         String
  organizationId String?
  apiKeyId       String?
  model          String?
  provider       String?
  promptHash     String?
  status         String
  latencyMs      Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  apiKey       ApiKey?       @relation(fields: [apiKeyId], references: [id])
  usageLedger  UsageLedger?
}
