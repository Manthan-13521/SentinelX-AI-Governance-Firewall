# SentinelX API - Production Environment Variables
# Copy this to .env.production and fill in all values
# NEVER commit this file with real secrets

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# =============================================================================
# WEB ORIGIN (for CORS)
# Must match the production web URL exactly
# =============================================================================
WEB_ORIGIN=https://sentinel--ai.vercel.app

# =============================================================================
# DATABASE (PostgreSQL - MongoDB Atlas or similar)
# =============================================================================
DATABASE_URL=postgresql://user:password@host:5432/sentinelx?sslmode=require

# =============================================================================
# REDIS (Upstash or similar)
# =============================================================================
REDIS_URL=redis://default:password@host:port

# Alternative: Upstash REST API (if using Upstash)
# UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token

# =============================================================================
# AUTHENTICATION
# =============================================================================
JWT_SECRET=your-super-secure-random-string-min-32-chars
NEXTAUTH_SECRET=your-super-secure-random-string-min-32-chars
NEXTAUTH_URL=https://sentinel--ai.vercel.app

# Google OAuth (configured in Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =============================================================================
# LLM PROVIDERS (at least one required for AI features)
# =============================================================================
OPENAI_API_KEY=sk-your-openai-key
OPENROUTER_API_KEY=sk-or-your-openrouter-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Optional: Ollama (self-hosted)
# OLLAMA_ENABLED=1
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Default models (optional - defaults used if not set)
DEFAULT_LLM_MODEL_OPENAI=gpt-4o-mini
DEFAULT_LLM_MODEL_OPENROUTER=openai/gpt-4o-mini
DEFAULT_LLM_MODEL_GEMINI=gemini-1.5-flash
DEFAULT_LLM_MODEL_CLAUDE=claude-3-5-haiku-20241022
DEFAULT_LLM_MODEL_OLLAMA=llama3.1

# AI Feature Flags
AI_REWRITE=1
ADAPTIVE_RISK_AI=1
LLM_SILENT=0

# =============================================================================
# OBSERVABILITY & INTEGRATIONS
# =============================================================================
# Sentry (error tracking)
SENTRY_DSN=https://your-key@sentry.io/project-id

# PostHog (analytics)
POSTHOG_API_KEY=phc_your-posthog-key
POSTHOG_HOST=https://us.i.posthog.com

# Cloudinary (file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Resend (email)
RESEND_API_KEY=re_your-resend-key
FROM_EMAIL=SentinelX <noreply@yourdomain.com>

# Slack (notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/XXX/XXX

# =============================================================================
# BILLING (Razorpay)
# =============================================================================
RAZORPAY_KEY_ID=rzp_live_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# PIPELINE PACING (for demo animation)
# =============================================================================
PIPELINE_PACE_MS=240
PIPELINE_PACE_JITTER_MS=220