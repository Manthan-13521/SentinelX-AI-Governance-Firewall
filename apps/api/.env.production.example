# SentinelX API - Production Environment Template
# Copy this to .env and fill in all required values for production deployment
# NEVER commit actual secrets to version control

# =============================================================================
# CORE APPLICATION
# =============================================================================
NODE_ENV=production
PORT=3001
WEB_ORIGIN=https://sentinelx.ai

# =============================================================================
# DATABASE (MongoDB Atlas)
# =============================================================================
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/sentinelx?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/sentinelx?retryWrites=true&w=majority

# =============================================================================
# REDIS (Upstash)
# =============================================================================
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Alternative Redis connection (if using ioredis directly)
REDIS_URL=redis://username:password@host:port

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
COOKIE_SECRET=your-super-secret-cookie-key-min-32-chars

# =============================================================================
# LLM PROVIDERS (At least one required for AI features)
# =============================================================================
# OpenRouter (Primary - supports failover)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_DEFAULT_MODEL=nvidia/nemotron-3-ultra
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super
OPENROUTER_SECONDARY_MODEL=openai/gpt-oss-20b

# OpenAI (Direct)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_LLM_MODEL_OPENAI=gpt-4o-mini

# Google Gemini
GEMINI_API_KEY=your-gemini-api-key
DEFAULT_LLM_MODEL_GEMINI=gemini-1.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
DEFAULT_LLM_MODEL_CLAUDE=claude-3-5-haiku-20241022

# Ollama (Local)
OLLAMA_ENABLED=0
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL_OLLAMA=llama3.1

# =============================================================================
# GOOGLE OAUTH
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars
NEXTAUTH_URL=https://sentinelx.ai

# =============================================================================
# BILLING - RAZORPAY
# =============================================================================
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-secret
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# =============================================================================
# CLOUDINARY (Media Storage)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# =============================================================================
# EMAIL (Resend)
# =============================================================================
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# NOTIFICATIONS (Slack)
# =============================================================================
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK/URL

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================
POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
POSTHOG_HOST=https://app.posthog.com

SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxx@o1.ingest.sentry.io/xxxxxxx

# =============================================================================
# PIPELINE SETTINGS
# =============================================================================
PIPELINE_PACE_MS=240
PIPELINE_PACE_JITTER_MS=220

# AI Feature Flags
AI_REWRITE=1
ADAPTIVE_RISK_AI=1
LLM_SILENT=0

# =============================================================================
# WEB ORIGIN (CORS)
# =============================================================================
WEB_ORIGIN=https://sentinelx.ai