# SentinelX API configuration
# All values are optional — the API runs in demo mode (in-memory store)
# when PostgreSQL and Redis are unavailable, and in simulated-LLM mode
# when no provider key is set.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sentinelx"
REDIS_URL="redis://localhost:6379"
PORT=3001
WEB_ORIGIN="http://localhost:3000"

# Pipeline pacing (ms). Controls the per-stage animation speed of the live
# agent pipeline. Set both to 0 to disable pacing.
PIPELINE_PACE_MS=240
PIPELINE_PACE_JITTER_MS=220

# --- LLM providers (optional) -------------------------------------------
# Set at least one key to enable real AI responses; otherwise the API runs
# in simulated mode and falls back to deterministic rule-based answers.
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# OLLAMA is enabled by flag, not key:
OLLAMA_ENABLED=0
OLLAMA_BASE_URL="http://localhost:11434"

# Default models per provider (optional)
DEFAULT_LLM_MODEL_OPENAI="gpt-4o-mini"
DEFAULT_LLM_MODEL_OPENROUTER="openai/gpt-4o-mini"
DEFAULT_LLM_MODEL_GEMINI="gemini-1.5-flash"
DEFAULT_LLM_MODEL_CLAUDE="claude-3-5-haiku-20241022"
DEFAULT_LLM_MODEL_OLLAMA="llama3.1"

# --- AI feature flags ---------------------------------------------------
# Set to 1 to route these agents through the LLM provider layer.
AI_REWRITE=1
ADAPTIVE_RISK_AI=1

# Suppress LLM availability warnings in logs.
LLM_SILENT=0
